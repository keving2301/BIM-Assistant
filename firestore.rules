rules_version = '2';
// Each signed-in user reads and writes only their own profile (userdata/{uid}) and the projects under it
// (userdata/{uid}/buckets/{project}). Nothing else is readable or writable.
//
// The public demo account (its sign-in button is on the sign-in page) can read its own data but not write it, so a
// visitor cannot delete the seeded projects or rewrite the profile. The Netlify Functions refuse the same account
// for creating projects, uploading, translating and deleting.
service cloud.firestore {
  match /databases/{database}/documents {
    function isDemoAccount() {
      return request.auth.uid == 'mp6eXC0l8vfLBfAHwoAH050YRcR2';
    }

    match /userdata/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && !isDemoAccount();
    }
  }
}
